# Server Port
PORT=5000

# OpenRouter API Key (Required for backend AI processing)
# Get a FREE API key from OpenRouter:
# 1. Visit https://openrouter.ai
# 2. Sign up or log in
# 3. Go to Settings/API Keys section
# 4. Create a new API key and copy it here
# Note: Free tier provides generous usage limits with various AI models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Firebase Web Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API URL (for production hosting)
VITE_API_BASE_URL=
